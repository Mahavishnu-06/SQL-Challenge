with table1 as(
select visited_on,sum(amount) as amount from Customer group by visited_on)
select visited_on ,sum(amount) over(order by visited_on rows between 6 preceding and   current row) as amount ,Round(avg(amount)over(order by visited_on rows between 6 preceding and   current row),2)  as average_amount from table1  limit 6,10000;
